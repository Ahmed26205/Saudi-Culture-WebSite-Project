{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "assets/**/*"
    }
  },
  "routes": [
    {
      "src": "/(CSS|JS|assets)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*\\.php)$",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
